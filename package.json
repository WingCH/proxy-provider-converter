{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:worker-types": "wrangler types",
    "typecheck": "pnpm run generate:worker-types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "worker:dev": "pnpm run build && wrangler dev",
    "worker:bundle-check": "wrangler deploy --dry-run --strict --outdir .wrangler/dry-run",
    "worker:dry-run": "pnpm run build && pnpm run worker:bundle-check",
    "worker:startup": "wrangler check startup --outfile .wrangler/worker-startup.cpuprofile",
    "deploy": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run worker:bundle-check && pnpm run worker:startup && wrangler deploy --strict",
    "start": "vite preview",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.7.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vercel/node": "^5.5.4",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  }
}
