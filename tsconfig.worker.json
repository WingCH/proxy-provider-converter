  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["./worker-configuration.d.ts"],
    "noEmit": true
  },
  "include": [
    "worker/index.ts",
    "src/api/convert-query.ts",
